{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/dashboard/tickets/[id]/clone",
      "regex": "^/dashboard/tickets/([^/]+?)/clone(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/tickets/(?<nxtPid>[^/]+?)/clone(?:/)?$"
    },
    {
      "page": "/dashboard/tickets/[id]/edit",
      "regex": "^/dashboard/tickets/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/tickets/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/airlines",
      "regex": "^/dashboard/airlines(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/airlines(?:/)?$"
    },
    {
      "page": "/dashboard/classes",
      "regex": "^/dashboard/classes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/classes(?:/)?$"
    },
    {
      "page": "/dashboard/new-ticket",
      "regex": "^/dashboard/new\\-ticket(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/new\\-ticket(?:/)?$"
    },
    {
      "page": "/dashboard/tickets",
      "regex": "^/dashboard/tickets(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/tickets(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}